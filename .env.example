# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# LLM router tiers (override to switch models without code changes)
# Probed 30 Oct 2026 on the free tier: Pro models = 429 (no free quota), 3.7/3.8-flash = 504 timeouts.
# Each tier is a comma-separated fallback chain (first that answers wins).
FINN_MODEL_CHEAP=gemini-3.5-flash-lite,gemini-3.1-flash-lite
FINN_MODEL_EXTRACT=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
FINN_MODEL_REASON=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Database: sqlite locally, Postgres (Neon) in production
DATABASE_URL=sqlite:///data/finn.db
# Frontend -> backend
NEXT_PUBLIC_API_BASE=http://localhost:8000
